
from typing import Generator

from fastapi import Depends, FastAPI, HTTPException, Query
from fastapi.middleware.cors import CORSMiddleware
from sqlalchemy import func, or_, select
from sqlalchemy.orm import Session

from backend.database import SessionLocal
from backend.models import SchemeCandidate

app = FastAPI(
    title="MahaSeva AI API",
    description="Maharashtra government scheme discovery API",
    version="0.2.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173"],
    allow_credentials=False,
    allow_methods=["GET"],
    allow_headers=["*"],
)


def get_db() -> Generator[Session, None, None]:
    with SessionLocal() as db:
        yield db


@app.get("/api/health")
def health():
    return {"status": "ok", "service": "mahaseva-ai-api"}


@app.get("/api/v1/schemes/summary")
def scheme_summary(db: Session = Depends(get_db)):
    total = db.scalar(
        select(func.count()).select_from(SchemeCandidate)
    ) or 0

    status_rows = db.execute(
        select(
            SchemeCandidate.verification_status,
            func.count(),
        ).group_by(SchemeCandidate.verification_status)
    ).all()

    return {
        "total_candidates": total,
        "statuses": {
            status: count for status, count in status_rows
        },
    }


@app.get("/api/v1/schemes")
def search_schemes(
    q: str = Query(default="", max_length=200),
    limit: int = Query(default=20, ge=1, le=100),
    offset: int = Query(default=0, ge=0),
    db: Session = Depends(get_db),
):
    statement = select(SchemeCandidate)

    if q.strip():
        term = f"%{q.strip()}%"
        statement = statement.where(
            or_(
                SchemeCandidate.title.like(term),
                SchemeCandidate.department.like(term),
                SchemeCandidate.text.like(term),
            )
        )

    total = db.scalar(
        select(func.count()).select_from(statement.subquery())
    ) or 0

    records = db.scalars(
        statement.order_by(SchemeCandidate.id)
        .offset(offset)
        .limit(limit)
    ).all()

    return {
        "total": total,
        "limit": limit,
        "offset": offset,
        "items": [
            {
                "id": item.id,
                "title": item.title,
                "department": item.department,
                "source_url": item.source_url,
                "provider_classification": item.provider_classification,
                "verification_status": item.verification_status,
                "notes": item.notes,
            }
            for item in records
        ],
    }


@app.get("/api/v1/schemes/{scheme_id}")
def get_scheme(
    scheme_id: int,
    db: Session = Depends(get_db),
):
    item = db.get(SchemeCandidate, scheme_id)

    if item is None:
        raise HTTPException(status_code=404, detail="Candidate not found")

    return {
        "id": item.id,
        "title": item.title,
        "department": item.department,
        "source_url": item.source_url,
        "source_type": item.source_type,
        "text": item.text,
        "pdf_urls": item.pdf_urls,
        "provider_classification": item.provider_classification,
        "verification_status": item.verification_status,
        "notes": item.notes,
        "retrieved_at_utc": item.retrieved_at_utc,
    }
