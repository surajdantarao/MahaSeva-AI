# MahaSeva AI - Environment Configuration Example
# Copy this file to .env and configure your values.
# NEVER commit .env to source control.

# Database Configuration (MySQL)
DATABASE_URL=mysql+pymysql://mahaseva_user:your_password_here@localhost:3306/mahaseva_ai

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_32_byte_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Collector Configuration
COLLECTOR_USER_AGENT=MahaSevaSchemeResearchBot/1.0 (contact: info@mahaseva.gov.in)
REQUEST_DELAY_SECONDS=1.5
REQUEST_TIMEOUT_SECONDS=25
MAX_PAGES_PER_SITE=80
MAX_PDF_MB=30

# AI Provider Configuration (rule_based | openai | gemini | local)
# The application functions completely with grounded retrieval even if no external AI API key is configured.
AI_PROVIDER=rule_based
AI_API_KEY=
AI_MODEL=
